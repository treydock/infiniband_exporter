    expr: sum(infiniband:switch_port_looping_errors:rate5m) without (host, port, uplink, uplink_port)
- name: infiniband-record-ibswinfo
  rules:
  - record: infiniband:switch_uptime_seconds
    expr: infiniband_switch_uptime_seconds * on(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_power_supply_status_info
    expr: infiniband_switch_power_supply_status_info * on(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_power_supply_dc_power_status_info
    expr: infiniband_switch_power_supply_dc_power_status_info * on(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_power_supply_fan_status_info
    expr: infiniband_switch_power_supply_fan_status_info * on(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_power_supply_watts
    expr: infiniband_switch_power_supply_watts * on(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_temperature_celsius
    expr: infiniband_switch_temperature_celsius * on(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_fan_status_info
    expr: infiniband_switch_fan_status_info * on(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_fan_rpm
    expr: infiniband_switch_fan_rpm * on(guid) group_left(switch, lid) infiniband_switch_info
- name: infiniband-switch-aggregates
  rules:
  - record: infiniband:switch_port_bit_error_rate:switch_delta1h
    expr: |
      infiniband:switch_port_symbol_error:switch_delta1h /
      ((infiniband:switch_port_transmit_data_bytes:delta1h + infiniband:switch_port_receive_data_bytes:delta1h) * 8)
- name: infiniband-record-metrics
  rules:
  - record: infiniband:switch_collect_duration_seconds
    expr: infiniband_switch_collect_duration_seconds * ON(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_collect_error
    expr: infiniband_switch_collect_error * ON(guid) group_left(switch, lid) infiniband_switch_info
  - record: infiniband:switch_collect_timeout
    expr: infiniband_switch_collect_timeout * ON(guid) group_left(switch, lid) infiniband_switch_info
- name: infiniband
  rules:
  - alert: InfinibandCollectError
    expr: infiniband_exporter_collect_errors > 0
    for: 20m
    labels:
      severity: warning
      alertgroup: infiniband
    annotations:
      title: InfiniBand collector {{ $labels.collector }} for {{ $labels.instance }} has {{ $value }} errors
      description: InfiniBand collector {{ $labels.collector }} for {{ $labels.instance }} has {{ $value }} errors
  - alert: InfinibandCollectTimeout
    expr: infiniband_exporter_collect_timeouts > 0
    for: 20m
    labels:
      severity: warning
      alertgroup: infiniband
    annotations:
      title: InfiniBand collector {{ $labels.collector }} for {{ $labels.instance }} has {{ $value }} time outs
      description: InfiniBand collector {{ $labels.collector }} for {{ $labels.instance }} has {{ $value }} time outs
  - alert: InfinibandCollectorStale
    expr: (time() - infiniband_exporter_last_execution) > 900
    for: 10m
    labels:
      severity: warning
      alertgroup: infiniband
    annotations:
      title: Infiniband collector {{ $labels.collector }} on {{ $labels.instance }} is stale
      description: Infiniband collector {{ $labels.collector }} on {{ $labels.instance }} has not run in {{ $value | humanizeDuration }}
  - alert: InfinibandSwitchFanStatus
    expr: infiniband:switch_fan_status_info{status!="OK"} == 1
    for: 10m
    labels:
      severity: warning
      alertgroup: infiniband
    annotations:
      title: Infiniband switch {{ $labels.switch }} has fan status {{ $labels.status }}
      description: Infiniband switch {{ $labels.switch }} has fan status {{ $labels.status }}
  - alert: InfinibandSwitchDCPowerStatus
    expr: infiniband:switch_power_supply_dc_power_status_info{status!="OK"} == 1
    for: 10m
    labels:
      severity: warning
      alertgroup: infiniband
    annotations:
      title: Infiniband switch {{ $labels.switch }} has DC Power status {{ $labels.status }} on PSU {{ $labels.psu }}
      description: Infiniband switch {{ $labels.switch }} has DC Power status {{ $labels.status }} on PSU {{ $labels.psu }}
  - alert: InfinibandSwitchPowerSupplyFanStatus
    expr: infiniband:switch_power_supply_fan_status_info{status!="OK"} == 1
    for: 10m
    labels:
      severity: warning
      alertgroup: infiniband
    annotations:
      title: Infiniband switch {{ $labels.switch }} has power supply fan status {{ $labels.status }} on PSU {{ $labels.psu }}
      description: Infiniband switch {{ $labels.switch }} has power supply fan status {{ $labels.status }} on PSU {{ $labels.psu }}
  - alert: InfinibandSwitchPowerSupplyStatus
    expr: infiniband:switch_power_supply_status_info{status!="OK"} == 1
    for: 10m
    labels:
      severity: warning
      alertgroup: infiniband
    annotations:
      title: Infiniband switch {{ $labels.switch }} has power supply status {{ $labels.status }} on PSU {{ $labels.psu }}
      description: Infiniband switch {{ $labels.switch }} has power supply status {{ $labels.status }} on PSU {{ $labels.psu }}
  - alert: InfinibandSwitchCongestion
    expr: avg_over_time(infiniband:switch_port_transmit_wait:switch_delta5m[15m:]) > 2.5e12
    for: 1h
    labels:
      severity: warning
      alertgroup: infiniband
    annotations:
      title: Infiniband switch {{ $labels.switch }} is experiencing high congestion
      description: Infiniband switch {{ $labels.switch }} is experiencing congestion for at least 1 hour.
  - alert: InfinibandTransmitDiscards
    expr: avg_over_time(infiniband:switch_port_transmit_discards:delta5m{uplink=~"ufm.+"}[1h]) != 0
    for: 1h
    labels:
      severity: page
      alertgroup: infiniband
    annotations:
      title: Infiniband switch {{ $labels.switch }} port {{ $labels.port }} uplink {{ $labels.uplink }} has transmit discards
      description: Infiniband switch {{ $labels.switch }} port {{ $labels.port }} uplink {{ $labels.uplink }} has transmit discards
